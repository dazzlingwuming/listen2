+package com.doublesymmetry.kotlinaudio.players;
+
+import com.google.android.exoplayer2.ExoPlayer;
+import com.google.android.exoplayer2.analytics.AnalyticsListener;
+import java.util.concurrent.atomic.AtomicInteger;
+import java.util.concurrent.atomic.AtomicLong;
+
+/**
+ * Process-local bridge owned by the pinned RNTP service.  It never crosses the
+ * React boundary and it neither creates nor controls a player.  Package access
+ * is intentional: kotlin-audio keeps the actual ExoPlayer protected.
+ */
+public final class Listen2AudioSessionBridge {
+    private static final AtomicInteger SESSION_ID = new AtomicInteger(0);
+    private static final AtomicLong GENERATION = new AtomicLong(0L);
+    private static ExoPlayer player;
+    private static AnalyticsListener listener;
+
+    private Listen2AudioSessionBridge() {}
+
+    public static synchronized void bind(QueuedAudioPlayer queuedPlayer) {
+        unbind();
+        if (queuedPlayer == null) return;
+        final ExoPlayer actualPlayer = queuedPlayer.getExoPlayer();
+        listener = new AnalyticsListener() {
+            @Override public void onAudioSessionIdChanged(EventTime eventTime, int audioSessionId) {
+                SESSION_ID.set(audioSessionId > 0 ? audioSessionId : 0);
+                GENERATION.incrementAndGet();
+            }
+        };
+        player = actualPlayer;
+        actualPlayer.addAnalyticsListener(listener);
+        final int audioSessionId = actualPlayer.getAudioSessionId();
+        SESSION_ID.set(audioSessionId > 0 ? audioSessionId : 0);
+        GENERATION.incrementAndGet();
+    }
+
+    public static synchronized void unbind() {
+        if (player != null && listener != null) player.removeAnalyticsListener(listener);
+        player = null;
+        listener = null;
+        SESSION_ID.set(0);
+        GENERATION.incrementAndGet();
+    }
+
+    public static int sessionId() { return SESSION_ID.get(); }
+    public static long generation() { return GENERATION.get(); }
+}
