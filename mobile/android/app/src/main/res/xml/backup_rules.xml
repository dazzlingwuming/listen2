<?xml version="1.0" encoding="utf-8"?>
<!--
  Keep private playback, provider, and analysis state out of legacy Android
  Auto Backup. Semantic library export/import is the only supported transfer.
-->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
    <exclude domain="external" path="." />
    <exclude domain="root" path="." />
</full-backup-content>
