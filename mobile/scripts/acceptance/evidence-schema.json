{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Listen2 Phase 8 redacted evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "runId", "recordId", "recordedAt", "git", "toolchain",
    "build", "device", "network", "fixture", "command", "outcome",
    "requirements", "metrics", "artifacts", "uncovered", "recovery"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "runId": { "type": "string", "pattern": "^phase08-[0-9]{8}T[0-9]{6}Z-[0-9a-f]{12}$" },
    "recordId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "recordedAt": { "type": "string", "format": "date-time" },
    "git": { "type": "object" },
    "toolchain": { "type": "object" },
    "build": { "type": "object" },
    "device": { "type": "object" },
    "network": { "type": "object" },
    "fixture": { "type": "object" },
    "command": { "type": "object" },
    "outcome": { "enum": ["PASS", "FAIL", "BLOCKED", "DEGRADED", "NOT_VERIFIED"] },
    "requirements": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[A-Z]+-[0-9]{3}$" } },
    "metrics": { "type": "array" },
    "artifacts": { "type": "array" },
    "uncovered": { "type": "array" },
    "recovery": { "type": "object" }
  }
}
